# ==============================================================================
# JARGO TELEGRAM MEDIA DOWNLOADER USERBOT CONFIGURATION
# Pure Go MTProto Engine targeting Linux / Android Termux ARM64
# ==============================================================================

# Telegram API credentials from https://my.telegram.org
TG_APP_ID=YOUR ID
TG_APP_HASH=YOUR HASH

# Optional: Account Phone Number (international format, e.g., +1234567890)
TG_PHONE_NUMBER=+62 YOUR PHONE

# Persistent Session file storage path (preserves AuthKey across restarts)
TG_SESSION_PATH=session.json

# Local directory where media will be streamed/saved
# For Termux default storage: /data/data/com.termux/files/home/downloads or /sdcard/Download/TelegramUserbot
TG_DOWNLOAD_DIR=downloads

# Single-character command trigger to download replied media (default: "d")
TG_TRIGGER_CMD=d

# Concurrency & Chunk tuning (optimised for ARM64 low memory)
# Chunk size in bytes for streaming (default: 524288 = 512KB, max: 1048576 = 1MB)
TG_CHUNK_SIZE=524288
TG_MAX_CONCURRENT_DOWNLOADS=3

# Logging level: trace, debug, info, warn, error
LOG_LEVEL=info
LOG_PRETTY=true
